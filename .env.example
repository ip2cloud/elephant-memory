# ---- Identidade (producao: Cloudflare Access) --------------------------------
AUTH_MODE=cloudflare
CF_ACCESS_TEAM_DOMAIN=seutime.cloudflareaccess.com
# AUD tag da aplicacao: Zero Trust > Access > Applications > sua app > Overview
CF_ACCESS_AUD=
# Service token -> claim `common_name`. Login humano -> troque para `email`.
CF_ACCESS_IDENTITY_CLAIM=common_name

# Token do Cloudflare Tunnel (Zero Trust > Networks > Tunnels).
# Com tunel nao ha porta aberta nem IP publico: nao existe origin pra contornar.
CF_TUNNEL_TOKEN=

# Escopos por identidade do Access. Identidade ausente = SO LEITURA.
#   read   = buscar
#   write  = MCP `remember` (uso manual, Cowork)
#   ingest = endpoint /ingest (publicador do handoff)
# A chave e o `common_name` do service token (ou o e-mail, se login humano).
CF_ACCESS_GRANTS={"publicador-scout":["read","ingest"],"alfredo-pessoal":["read","write"]}

# ---- Alternativa local, sem Cloudflare no caminho ----------------------------
# Descomente as duas linhas abaixo e comente AUTH_MODE=cloudflare acima.
#
# ATENCAO ao formato: a forma curta ({"tok_...": "alfredo"}) concede SO LEITURA,
# de proposito — token que vai versionado no .mcp.json de um repo nao deve
# ganhar escrita por omissao. Se voce copiar so a forma curta, sobe um servidor
# onde NADA grava, e o sintoma e "Esta credencial nao tem permissao 'write'".
#
# Gere cada token com:
#   python3 -c "import secrets;print('tok_'+secrets.token_urlsafe(32))"
#
# AUTH_MODE=token
# AUTH_TOKENS={"tok_SOMENTE_LEITURA_troque_isso_aqui_ok":"alfredo","tok_PESSOAL_troque_isso_aqui_okay":{"user":"alfredo","scopes":["read","write"]},"tok_PUBLICADOR_troque_isso_aqui_ok":{"user":"publicador","scopes":["read","ingest"]}}

# ---- FalkorDB ----------------------------------------------------------------
FALKORDB_PASSWORD=troque_isso
FALKORDB_DATABASE=memoria

# ---- OpenAI (extracao de entidades e relacoes) -------------------------------
# A ingestao do Graphiti custa mais que a de um vector store: alem de extrair
# fatos, ele resolve entidades, relacoes e invalidacao temporal.
OPENAI_API_KEY=sk-...

# ---- Operacao ----------------------------------------------------------------
RATE_LIMIT=120
RATE_WINDOW=60
LOG_LEVEL=INFO
