# Segredos. O .env tem chave da OpenAI, senha do FalkorDB, tokens de acesso e
# o token do Cloudflare Tunnel. NUNCA versione. Use o .env.example como molde.
.env
.env.*
!.env.example

# Overlay local: publica portas no loopback e dispensa o Access. Nao e segredo,
# mas tambem nao e producao — cada maquina escolhe se quer.
# (remova esta linha se quiser versiona-lo)
docker-compose.local.yml

# Area de descarte. Guardar copia velha aqui e versiona-la junto seria pior
# que apagar: vira uma segunda fonte de verdade que ninguem mantem.
_to_delete/

__pycache__/
*.py[cod]
.venv/
venv/

.DS_Store
